{
  "name": "typst-book-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian desktop plugin for compiling Typst files, previewing PDFs, and adding Typst writing tools.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.0",
    "obsidian": "^1.5.12",
    "typescript": "^5.4.2"
  }
}
